# Entity: poem

main: kit: entity: poem: {

  alias: field: {}

  fields: [
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "lines"
      req: true
      short: "The lines of the poem"
      type: "`$ARRAY`"
    }
    {
      name: "title"
      req: true
      short: "The title of the poem"
      type: "`$STRING`"
    }
    {
      name: "volume"
      req: true
      short: "The volume number of the Bleach manga"
      type: "`$INTEGER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "poem"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/poems"
          segments: [
            {
              lit: "poems"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.poems`"
          }
        }
        {
          method: "GET"
          orig: "/random"
          segments: [
            {
              lit: "random"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.lines`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: 1
                kind: "param"
                name: "id"
                orig: "volume"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/poems/{volume}"
          rename: {
            param: {
              volume: "id"
            }
          }
          segments: [
            {
              lit: "poems"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}

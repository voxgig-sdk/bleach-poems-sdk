# Entity: poem

main: kit: entity: poem: {

  alias: field: {}

  fields: [
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "lines"
      req: true
      short: "The lines of the poem"
      type: "`$ARRAY`"
    }
    {
      name: "title"
      req: true
      short: "The title of the poem"
      type: "`$STRING`"
    }
    {
      name: "volume"
      req: true
      short: "The volume number of the Bleach manga"
      type: "`$INTEGER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "poem"
  op: {
    list: {
      name: "list"
      points: [
        {
          contract: {
            id: "GET /poems"
            json: "{\"operationId\":\"getAllPoems\",\"parameters\":[],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"example\":{\"poems\":[{\"lines\":[\"We fear that which we cannot see\"],\"title\":\"Death and Strawberry\",\"volume\":1}]},\"schema\":{\"properties\":{\"poems\":{\"description\":\"Array of all poems from Bleach volumes 1-74\",\"items\":{\"properties\":{\"lines\":{\"description\":\"The lines of the poem\",\"example\":[\"We fear that which we cannot see\"],\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"title\":{\"description\":\"The title of the poem\",\"example\":\"Death and Strawberry\",\"type\":\"string\"},\"volume\":{\"description\":\"The volume number of the Bleach manga\",\"example\":1,\"maximum\":74,\"minimum\":1,\"type\":\"integer\"}},\"required\":[\"volume\",\"title\",\"lines\"],\"type\":\"object\"},\"type\":\"array\"}},\"required\":[\"poems\"],\"type\":\"object\"}}},\"description\":\"Successful response containing all poems\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/poems"
          segments: [
            {
              lit: "poems"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.poems`"
          }
        }
        {
          contract: {
            id: "GET /random"
            json: "{\"operationId\":\"getRandomPoem\",\"parameters\":[],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"example\":{\"lines\":[\"If you want to know me\",\"look inside your heart\"],\"title\":\"Heart\",\"volume\":42},\"schema\":{\"properties\":{\"lines\":{\"description\":\"The lines of the poem\",\"example\":[\"We fear that which we cannot see\"],\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"title\":{\"description\":\"The title of the poem\",\"example\":\"Death and Strawberry\",\"type\":\"string\"},\"volume\":{\"description\":\"The volume number of the Bleach manga\",\"example\":1,\"maximum\":74,\"minimum\":1,\"type\":\"integer\"}},\"required\":[\"volume\",\"title\",\"lines\"],\"type\":\"object\"}}},\"description\":\"Successful response containing a random poem\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/random"
          segments: [
            {
              lit: "random"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.lines`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: 1
                kind: "param"
                name: "id"
                orig: "volume"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          contract: {
            id: "GET /poems/{volume}"
            json: "{\"operationId\":\"getPoemByVolume\",\"parameters\":[{\"description\":\"Volume number (must be between 1 and 74)\",\"example\":1,\"in\":\"path\",\"name\":\"volume\",\"required\":true,\"schema\":{\"maximum\":74,\"minimum\":1,\"type\":\"integer\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"example\":{\"lines\":[\"We fear that which we cannot see\"],\"title\":\"Death and Strawberry\",\"volume\":1},\"schema\":{\"properties\":{\"lines\":{\"description\":\"The lines of the poem\",\"example\":[\"We fear that which we cannot see\"],\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"title\":{\"description\":\"The title of the poem\",\"example\":\"Death and Strawberry\",\"type\":\"string\"},\"volume\":{\"description\":\"The volume number of the Bleach manga\",\"example\":1,\"maximum\":74,\"minimum\":1,\"type\":\"integer\"}},\"required\":[\"volume\",\"title\",\"lines\"],\"type\":\"object\"}}},\"description\":\"Successful response containing the poem for the specified volume\"},\"400\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"error\":{\"description\":\"Error message\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Invalid volume number (not a number or out of range)\"},\"404\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"error\":{\"description\":\"Error message\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Poem not found for the specified volume\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/poems/{volume}"
          rename: {
            param: {
              volume: "id"
            }
          }
          segments: [
            {
              lit: "poems"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
